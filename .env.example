# ── Barbeiro (admin) ─────────────────────────────────────────────────────────
BARBEIRO_PHONE=55XXXXXXXXXXX

# ── DeepSeek LLM ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Google Calendar ──────────────────────────────────────────────────────────
# Compartilhe seu calendário com o email da service account com permissão de edição
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-calendar.json
# Coloque o JSON da service account em credentials/google-calendar.json

# ── Evolution API (WhatsApp bridge) ──────────────────────────────────────────
EVOLUTION_API_KEY=your_strong_api_key_here
EVOLUTION_INSTANCE=barbershop

# ── PostgreSQL (banco da Evolution API) ──────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here

# ── Recuperação de clientes inativos ─────────────────────────────────────────
# Dias sem visita para considerar cliente inativo
DIAS_INATIVIDADE=30
# Hora do dia (0-23) para disparar mensagens de recuperação automaticamente
HORARIO_RECUPERACAO=10
